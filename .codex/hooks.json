{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(spawn_agent|Agent|collaboration[.]?spawn_agent|multi_agent_v[12]spawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/subagents.py\" PreToolUse",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/subagents.py\" SubagentStart",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/subagents.py\" SubagentStop",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
